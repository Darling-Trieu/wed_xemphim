{
    "compilerOptions": {
        "target": "ES2017",
        "module": "none",
        "lib": ["ES2017", "DOM"],
        "outDir": "public/js",
        "rootDir": "ts",
        "strict": true,
        "noImplicitAny": true,
        "removeComments": true,
        "sourceMap": false
    },
    "include": ["ts/**/*.ts"]
}
