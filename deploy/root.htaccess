# .htaccess đặt ở thư mục gốc hosting (htdocs/).
# Hosting dùng chung (InfinityFree...) không cho đổi document root sang public/,
# nên chuyển mọi request vào public/ và chặn truy cập trực tiếp mã nguồn.
Options -Indexes
RewriteEngine On

# Chặn mã nguồn, cấu hình, log và file ẩn (.env, .git...)
RewriteRule ^(src|logs|database|deploy|deploy-data|tests|docs|ts|node_modules)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

# Mọi đường dẫn còn lại phục vụ từ public/ (URL không có chữ /public)
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
